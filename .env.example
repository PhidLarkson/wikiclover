# Environment Variables - Copy to .env.local and fill in values

# Wikimedia OAuth 2.0 Credentials (from OAuth consumer registration)
# Wikimedia OAuth Client ID
# Create one at: https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
# Settings:
# - Callback URL: http://localhost:5173/auth/callback (and your production URL)
# - Confidential: UNCHECKED (Public client)
# - Grants: Basic rights, Create/Edit/Move pages, Upload new files
VITE_WIKIMEDIA_CLIENT_ID=your_client_id_here

# Wikimedia Commons API Base
VITE_WIKIMEDIA_API_BASE=https://commons.wikimedia.org/w/api.php

# OAuth Redirect URI (must match registration exactly)
VITE_WIKIMEDIA_REDIRECT_URI=http://localhost:5173/auth/callback
